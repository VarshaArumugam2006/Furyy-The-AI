# ==========================================
# Google Gemini API Configuration
# ==========================================
# Step 1: Visit https://aistudio.google.com/app/apikey
# Step 2: Sign in with your Google account
# Step 3: Click "Create API Key"
# Step 4: Paste your API key below and save this file as .env
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini model selection
# Options: gemini-2.5-flash (recommended), gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Server port (default is 3000)
PORT=3000
